<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
	<name>COM_HOTSPOTS</name>
	<author>TLWebdesign</author>
	<creationDate>2026-11-03</creationDate>
	<copyright>(C) 2026 TLWebdesign. Based on Hotspots by compojoom.com, (C) 2008-2023</copyright>
	<authorEmail>info@tlwebdesign.nl</authorEmail>
	<authorUrl>https://tlwebdesign.nl</authorUrl>
	<version>7.0.1</version>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<description><![CDATA[<div style="text-align:left">Hotspots: markers on a Google map for Joomla 5 and 6, by TLWebdesign.</div>]]>
	</description>
	<namespace path="src">TLWebdesign\Component\Hotspots</namespace>
	<scriptfile>script.php</scriptfile>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
	<files folder="components/com_hotspots">
		<folder>forms</folder>
		<folder>layouts</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="language">
        <language tag="en-GB">en-GB/en-GB.com_hotspots.ini</language>
	</languages>
	<administration>
		<menu>COM_HOTSPOTS</menu>
		<submenu>
			<menu view="dashboard">COM_HOTSPOTS_DASHBOARD</menu>
			<menu view="hotspots">COM_HOTSPOTS_LOCATIONS</menu>
			<menu link="option=com_categories&amp;extension=com_hotspots">COM_HOTSPOTS_CATEGORIES</menu>
			<menu view="kmls">COM_HOTSPOTS_KMLS</menu>
			<menu view="customfields">COM_HOTSPOTS_CUSTOM_FIELDS</menu>
			<menu view="import">COM_HOTSPOTS_IMPORT</menu>
		</submenu>
		<files folder="administrator/components/com_hotspots">
			<file>access.xml</file>
			<file>config.xml</file>
			<folder>forms</folder>
			<folder>layouts</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator/language">
            <language tag="en-GB">en-GB/en-GB.com_hotspots.ini</language>
<language tag="en-GB">en-GB/en-GB.com_hotspots.sys.ini</language>
        </languages>
	</administration>
	<media destination="com_hotspots" folder="media/com_hotspots">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>images</folder>
		<folder>js</folder>
		<folder>backend</folder>
		<folder>kml</folder>
		<folder>vendor</folder>
	</media>

	<!-- Updates come through the Hotspots package (pkg_hotspots). -->
</extension>