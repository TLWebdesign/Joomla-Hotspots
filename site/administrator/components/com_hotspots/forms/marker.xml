<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="TLWebdesign\Component\Hotspots\Administrator\Field">
	<fieldset name="details">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" class="readonly"/>

		<field name="asset_id" type="hidden" filter="unset"/>

		<field name="title" type="text" label="COM_HOTSPOTS_HOTSPOT_TITLE_LABEL" required="true" maxlength="255"/>

		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" hint="JFIELD_ALIAS_PLACEHOLDER" maxlength="255"/>

		<field name="catid" type="categoryedit" extension="com_hotspots" label="JCATEGORY" required="true" addfieldprefix="Joomla\Component\Categories\Administrator\Field">
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>

		<field name="state" type="list" label="JSTATUS" default="1" filter="intval" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" filter="UINT" validate="options"/>

		<field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL">
			<option value="*">JALL</option>
		</field>

		<field name="hotspotText" type="editor" label="COM_HOTSPOTS_FIELD_DESCRIPTION"
			filter="\Joomla\CMS\Component\ComponentHelper::filterText" buttons="true" hide="article,image,pagebreak" required="true"/>

		<field name="picture" type="multimedia" label="COM_HOTSPOTS_PICTURE" description="COM_HOTSPOTS_PICTURE_DESC"
			url="index.php?option=com_hotspots&amp;task=multimedia.doIt" component="com_hotspots" maxNumberOfFiles="10"/>
	</fieldset>

	<fieldset name="location" label="COM_HOTSPOTS_LOCATION_DETAILS">
		<field name="street" type="text" label="COM_HOTSPOTS_STREET" maxlength="255"/>
		<field name="plz" type="text" label="COM_HOTSPOTS_ZIP" maxlength="10"/>
		<field name="town" type="text" label="COM_HOTSPOTS_FIELD_CITY" maxlength="255"/>
		<field name="administrative_area_level_1" type="text" label="COM_HOTSPOTS_FIELD_POLITICAL_STATE_LABEL" maxlength="255"/>
		<field name="country" type="text" label="COM_HOTSPOTS_COUNTRY" maxlength="255"/>
		<field name="gmlat" type="text" label="COM_HOTSPOTS_LATITUDE" required="true" filter="float" validate="number" min="-90" max="90"/>
		<field name="gmlng" type="text" label="COM_HOTSPOTS_LONGITUDE" required="true" filter="float" validate="number" min="-180" max="180"/>
	</fieldset>

	<fieldset name="publishing" label="COM_HOTSPOTS_FIELDSET_PUBLISHING">
		<field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc"/>
		<field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" validate="UserId"/>
		<field name="created_by_alias" type="text" label="JGLOBAL_FIELD_CREATED_BY_ALIAS_LABEL" maxlength="255"/>
		<field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" class="readonly" readonly="true" translateformat="true" showtime="true" filter="user_utc"/>
		<field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" class="readonly" readonly="true" filter="unset" validate="UserId"/>
		<field name="publish_up" type="calendar" label="JGLOBAL_FIELD_PUBLISH_UP_LABEL" translateformat="true" showtime="true" filter="user_utc"/>
		<field name="publish_down" type="calendar" label="JGLOBAL_FIELD_PUBLISH_DOWN_LABEL" translateformat="true" showtime="true" filter="user_utc"/>
	</fieldset>

	<fieldset name="accesscontrol" label="JGLOBAL_ACTION_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules"
			component="com_hotspots" section="marker" validate="rules"/>
	</fieldset>

	<fields name="params" label="COM_HOTSPOTS_MARKER_FIELDSET_OPTIONS">
		<fieldset name="markeroptions" label="COM_HOTSPOTS_MARKER_FIELDSET_OPTIONS">
			<field name="markerimage" type="markerimage" label="COM_HOTSPOTS_CUSTOM_HOTSPOT_ICON" description="COM_HOTSPOTS_CUSTOM_HOTSPOT_ICON_DESC"/>
			<field name="link_to" type="hotspotslink" label="COM_HOTSPOTS_LINK_TO" description="COM_HOTSPOTS_LINK_TO_DESCRIPTION"/>
			<field name="link_to_id" type="text" label="COM_HOTSPOTS_LINK_TO_ID" description="COM_HOTSPOTS_LINK_TO_ID_DESCRIPTION"
				hint="COM_HOTSPOTS_ENTER_ID" showon="link_to!:0[AND]link_to!:" filter="string"/>
			<field name="show_readmore" type="list" default="" label="COM_HOTSPOTS_SHOW_READMORE_LABEL" validate="options">
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<!-- A select (not a switcher): submit-hotspots.js reads #jform_params_sticky. -->
			<field name="sticky" type="list" default="1" label="COM_HOTSPOTS_STICKY_MARKER" description="COM_HOTSPOTS_STICKY_MARKER_DESCRIPTION" filter="intval" validate="options">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
