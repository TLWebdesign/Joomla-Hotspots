<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="TLWebdesign\Component\Hotspots\Administrator\Field">
	<fieldset name="details">
		<field name="id" type="text" default="0" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" class="readonly"/>
		<field name="title" type="text" label="COM_HOTSPOTS_CUSTOM_FIELDS_TITLE_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_TITLE_DESC" required="true" filter="string"/>
		<field name="component" type="hidden" default="com_hotspots.hotspot" filter="cmd"/>
		<field name="slug" type="text" label="COM_HOTSPOTS_CUSTOM_FIELDS_SLUG_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_SLUG_DESC" filter="string"/>
		<field name="show" type="list" default="all" label="COM_HOTSPOTS_CUSTOM_FIELDS_SHOW_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_SHOW_DESC" filter="word">
			<option value="all">COM_HOTSPOTS_CUSTOM_FIELDS_ALL_CATS_LABEL</option>
			<option value="category">COM_HOTSPOTS_CUSTOM_FIELDS_SPECIFIC_CATEGORY_LABEL</option>
		</field>
		<field name="catid" type="category" extension="com_hotspots" multiple="true" layout="joomla.form.field.list-fancy-select"
		       label="COM_HOTSPOTS_CUSTOM_FIELDS_HOTSPOTS_CATEGORIES_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_HOTSPOTS_CATEGORIES_DESC" showon="show:category" filter="intarray"/>
		<field name="type" type="customfieldtype" default="text" label="COM_HOTSPOTS_CUSTOM_FIELDS_FIELD_TYPE_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_FIELD_TYPE_DESC" filter="cmd"/>
		<field name="options" type="textarea" rows="6" label="COM_HOTSPOTS_CUSTOM_FIELDS_OPTIONS_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_OPTIONS_DESC" filter="raw"/>
		<field name="default" type="text" label="COM_HOTSPOTS_CUSTOM_FIELDS_DEFAULT_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_DEFAULT_DESC" filter="string"/>
		<field name="allow_empty" type="radio" layout="joomla.form.field.radio.switcher" default="1"
		       label="COM_HOTSPOTS_CUSTOM_FIELDS_ALLOW_EMPTY_LABEL"
		       description="COM_HOTSPOTS_CUSTOM_FIELDS_ALLOW_EMPTY_DESC" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="enabled" type="list" default="1" label="JSTATUS" class="form-select-color-state" filter="integer">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
	</fieldset>
</form>
