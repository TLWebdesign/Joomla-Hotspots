<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details">
		<field name="hotspots_kml_id" type="number" default="0" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" class="readonly"/>

		<field name="title" type="text" label="COM_HOTSPOTS_KML_FILE_TITLE" description="COM_HOTSPOTS_KML_FILE_TITLE_DESC" required="true" maxlength="255"/>

		<field name="catid" type="category" extension="com_hotspots" label="COM_HOTSPOTS_CATEGORY" required="true">
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>

		<field name="kml_file" type="file" label="COM_HOTSPOTS_KML_FILE" description="COM_HOTSPOTS_KML_FILE_DESC" accept=".kml,.kmz,.xml"/>

		<field name="description" type="editor" label="COM_HOTSPOTS_KML_FILE_DESCRIPTION" filter="\Joomla\CMS\Component\ComponentHelper::filterText" buttons="true"/>
	</fieldset>

	<fieldset name="publishing">
		<field name="state" type="list" label="JSTATUS" class="form-select-color-state" default="1" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc"/>

		<field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" validate="UserId"/>
	</fieldset>
</form>
