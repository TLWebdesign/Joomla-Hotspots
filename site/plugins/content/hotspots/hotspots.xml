<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>plg_content_hotspots</name>
    <author>TLWebdesign (originally compojoom.com)</author>
    <creationDate>2026-11-02</creationDate>
    <copyright>(C) 2012 compojoom.com, (C) 2026 TLWebdesign</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <authorEmail>info@tlwebdesign.nl</authorEmail>
    <authorUrl>https://tlwebdesign.nl</authorUrl>
    <version>7.0.0</version>
    <description>
        plg_content_hotspots_DESC
    </description>
    <namespace path="src">TLWebdesign\Plugin\Content\Hotspots</namespace>
    <languages folder="administrator/language">
        <language tag="en-GB">en-GB/en-GB.plg_content_hotspots.sys.ini</language>
    </languages>
    <files>
		<folder plugin="hotspots">services</folder>
		<folder>src</folder>
	</files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="map_height" type="input"
                       label="PLG_CONTENT_HOTSPOTS_MAP_HEIGHT"
                       description="PLG_CONTENT_HOTSPOTS_MAP_HEIGHT_DESC"
                       default="400"
                        />
	            <field name="map_width" type="input"
	                   label="PLG_CONTENT_HOTSPOTS_MAP_WIDTH_LABEL"
	                   description="PLG_CONTENT_HOTSPOTS_MAP_WIDTH_DESC"
	                   filter="int"
	                   default="0"
			            />
	            <field name="zoom" type="input"
	                   label="PLG_CONTENT_HOTSPOTS_MAP_ZOOM_LABEL"
	                   description="PLG_CONTENT_HOTSPOTS_MAP_ZOOM_DESC"
	                   filter="int"
	                   default="12"
			            />
            </fieldset>
        </fields>
    </config>
</extension>
