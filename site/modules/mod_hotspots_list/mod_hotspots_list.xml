<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_hotspots_list</name>
	<author>TLWebdesign (originally compojoom.com)</author>
	<creationDate>2026-11-02</creationDate>
	<copyright>(C) 2012 compojoom.com, (C) 2026 TLWebdesign</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<authorEmail>info@tlwebdesign.nl</authorEmail>
	<authorUrl>https://tlwebdesign.nl</authorUrl>
	<version>7.0.0</version>
	<description>MOD_HOTSPOTS_LIST_DESCRIPTION</description>
	<namespace path="src">TLWebdesign\Module\HotspotsList</namespace>
	<files>
		<folder module="mod_hotspots_list">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.mod_hotspots_list.ini</language>
		<language tag="en-GB">en-GB/en-GB.mod_hotspots_list.sys.ini</language>
	</languages>
	<media destination="mod_hotspots_list" folder="media/mod_hotspots_list">
		<folder>css</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
						name="catid"
						type="category"
						extension="com_hotspots"
						multiple="true"
						size="10"
						default=""
						published="1"
						label="JCATEGORY"
						description="MOD_HOTSPOTS_LIST_FIELD_CATEGORY_DESC">
				</field>
				<field
					name="author"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="MOD_HOTSPOTS_SHOW_AUTHOR_LABEL"
					description="MOD_HOTSPOTS_SHOW_AUTHOR_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
						name="image"
						type="radio"
						layout="joomla.form.field.radio.switcher"
						default="0"
						label="MOD_HOTSPOTS_SHOW_IMAGE_LABEL"
						description="MOD_HOTSPOTS_SHOW_IMAGE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
						name="description"
						type="radio"
						layout="joomla.form.field.radio.switcher"
						default="0"
						label="MOD_HOTSPOTS_SHOW_DESCRIPTION_LABEL"
						description="MOD_HOTSPOTS_SHOW_DESCRIPTION_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
						name="address"
						type="radio"
						layout="joomla.form.field.radio.switcher"
						default="0"
						label="MOD_HOTSPOTS_SHOW_ADDRESS_LABEL"
						description="MOD_HOTSPOTS_SHOW_ADDRESS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="date"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="MOD_HOTSPOTS_SHOW_DATE_LABEL"
					description="MOD_HOTSPOTS_SHOW_DATE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
						name="limit"
						type="number"
						min="1"
						filter="integer"
						default="10"
						label="MOD_HOTSPOTS_LIST_FIELD_LIMIT_LABEL"
						description="MOD_HOTSPOTS_LIST_FIELD_LIMIT_DESC"/>

				<field
						name="ordering"
						type="list"
						default="created"
						label="MOD_HOTSPOTS_LIST_FIELD_ORDERING_LABEL"
						description="MOD_HOTSPOTS_LIST_FIELD_ORDERING_DESC">
					<option
							value="created">MOD_HOTSPOTS_LIST_VALUE_CREATED
					</option>
					<option
							value="title">MOD_HOTSPOTS_LIST_VALUE_NAME
					</option>
				</field>

				<field
						name="direction"
						type="list"
						default="desc"
						label="MOD_HOTSPOTS_LIST_FIELD_DIRECTION_LABEL"
						description="MOD_HOTSPOTS_LIST_FIELD_DIRECTION_DESC">
					<option
							value="asc">MOD_HOTSPOTS_LIST_VALUE_ASC
					</option>
					<option
							value="desc">MOD_HOTSPOTS_LIST_VALUE_DSC
					</option>
				</field>

			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC" />
				<field
					name="moduleclass_sfx"
					type="textarea" rows="3"
					default=""
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
